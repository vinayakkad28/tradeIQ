# --- REQUIRED ---
# JWT secret for token signing. MUST be set, no default fallback.
# Generate: openssl rand -base64 48
JWT_SECRET=

# --- ENCRYPTION ---
# AES-256 key for encrypting broker credentials at rest.
# Falls back to JWT_SECRET if unset (not recommended for production).
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# --- DATABASE ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=tradeiq
DB_PASSWORD=tradeiq_dev
DB_NAME=tradeiq
DB_SSLMODE=disable

# --- REDIS ---
REDIS_URL=redis://localhost:6379

# --- APP ---
PORT=8080
GIN_MODE=debug
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
VERCEL_PROJECT_SLUG=tradeiq

# --- BROKER OAUTH ---
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
FYERS_APP_ID=
FYERS_SECRET_KEY=
ANGELONE_API_KEY=
ANGELONE_CLIENT_SECRET=
DHAN_CLIENT_ID=
DHAN_APP_ID=
DHAN_APP_SECRET=
