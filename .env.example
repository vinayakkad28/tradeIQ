# ── TradeIQ Environment Variables ────────────────────────
# Copy this file to .env and fill in your values

# ── Security ──────────────────────────────────────────────
JWT_SECRET=your_very_long_random_secret_at_least_64_chars

# ── App URLs ──────────────────────────────────────────────
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# ── Database (if not using Docker defaults) ───────────────
# DATABASE_URL=postgres://tradeiq:tradeiq_dev@localhost:5432/tradeiq?sslmode=disable

# ── Zerodha Kite API ──────────────────────────────────────
# Get from: https://developers.kite.trade/apps
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# ── Upstox Pro API v2 ─────────────────────────────────────
# Get from: https://upstox.com/developer/
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=

# ── Fyers API v3 ──────────────────────────────────────────
# Get from: https://myapi.fyers.in/
FYERS_APP_ID=
FYERS_SECRET_KEY=

# ── AngelOne SmartAPI ─────────────────────────────────────
# Get from: https://smartapi.angelbroking.com/
ANGELONE_CLIENT_ID=
ANGELONE_CLIENT_SECRET=

# ── Dhan HQ ───────────────────────────────────────────────
# Get from: https://dhanhq.co/docs/latest/
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# ── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
